{
  "name": "antonio-mascarenhas-portfolios",
  "version": "0.0.3",
  "private": true,
  "engines": {
    "node": ">=20.16.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm codegen && next dev --turbopack",
    "build": "next build",
    "build:local": "next build && pnpm generate-og",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "generate-og": "node scripts/generate-og.mjs",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "prepare": "husky",
    "worktree:create": "sh ./scripts/worktree-create.sh"
  },
  "dependencies": {
    "@apollo/client": "^4.2.3",
    "@apollo/client-integration-nextjs": "^0.14.5",
    "@floating-ui/react": "^0.27.19",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "graphql": "^16.14.2",
    "lucide-react": "^1.16.0",
    "next": "15.3.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "swiper": "^12.1.4",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@graphql-codegen/cli": "^7.1.3",
    "@graphql-codegen/client-preset": "^6.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.3.9",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.9"
}
