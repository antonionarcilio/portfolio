{
  "name": "antonio-mascarenhas-portfolio",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": "24.x",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm --filter './apps/*' build",
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:minimalist": "pnpm --filter minimalist dev",
    "dev:gamified": "pnpm --filter gamified dev",
    "dev:pro": "pnpm --filter pro dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "worktree:create": "sh ./scripts/worktree-create.sh"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.9"
}
