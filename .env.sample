MY_DOMAIN=https://example.com

# GitHub markdown CMS (repo público, sem token)
CMS_GITHUB_OWNER=owner
CMS_GITHUB_REPO=repo
CMS_GITHUB_BRANCH=master
CMS_GITHUB_WEBHOOK_SECRET=a_long_random_shared_secret

# Deploy Hook da Vercel (Project → Settings → Git → Deploy Hooks) — disparado
# por /api/revalidate a cada push no portfolio-cms. Ver docs/cms-content-updates.md
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/xxxxx/yyyyy
